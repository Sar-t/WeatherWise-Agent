OPENWEATHER_API_KEY=
GEOAPIFY_API_KEY=

# --- LLM (Google Gemini, free tier) -------------------------------------------
GOOGLE_API_KEY=
LLM_PROVIDER=google_genai
# Leave LLM_MODEL empty once to list the Flash models your key can use.
LLM_MODEL=

# Each message makes two LLM calls: extraction (understanding) and answer.
# The free tier allows about 20 requests per day PER MODEL, so one model covers ~10 messages a day.
# Pointing the two roles at different models gives each its own 20/day quota (~20 messages a day).
# Both default to LLM_MODEL when empty. These two passed the evals (Oct 2026): 28/28 understanding
# cases on 2.5-flash, and the answer eval on 3-flash-preview. Preview models can be retired; if
# ANSWER_MODEL stops working, use another 3.x Flash model that supports "minimal" thinking.
EXTRACTION_MODEL=gemini-2.5-flash
ANSWER_MODEL=gemini-3-flash-preview
EXTRACTION_TEMPERATURE=0
ANSWER_TEMPERATURE=0.3

# Thinking (reasoning) depth per role: minimal | low | medium | high, a token budget (e.g. 1024),
# or empty for the model's own default. "minimal" is the fastest; on Gemini 2.5 it turns thinking off.
EXTRACTION_THINKING=minimal
ANSWER_THINKING=minimal

# --- Guidelines RAG (local, no API key) -------------------------------------------
# A small multilingual sentence-transformers model (Hinglish queries); downloaded on first use.
# intfloat/multilingual-e5-small: ~118M parameters, ~470 MB, 384-dimensional vectors.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
VECTOR_STORE_DIR=data/vector_store

# --- HTTP API (uvicorn backend.api.app:app) -------------------------------------------
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///data/weatherwise.db
CHECKPOINT_DB=data/checkpoints.sqlite
# Per anonymous client (X-Client-Id). The daily cap protects the LLM free tier; error turns don't count.
RATE_LIMIT_PER_MINUTE=10
DAILY_MESSAGE_CAP=40
DASHBOARD_RATE_PER_MINUTE=60
MAX_MESSAGE_CHARS=500

# --- Optional LangSmith tracing (off by default) --------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=weatherwise
