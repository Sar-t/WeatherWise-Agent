# WeatherWise frontend settings. Copy to .env.local for development. NEXT_PUBLIC_* values are built
# into the JavaScript at `next build`, so set them before building for production.

# The backend API's base URL, without a trailing slash (e.g. https://api.weatherwise.example.in).
# The backend's CORS_ORIGINS must list this frontend's URL, or the browser refuses every request.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# This site's public URL, without a trailing slash (e.g. https://weatherwise.example.in). Used for
# absolute links in share previews (Open Graph and Twitter images) and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
